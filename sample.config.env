# This is a sample configuration file.
# Rename this file to config.env and fill in your actual values.

# Freepik API key (used by push_to_talk_transcribe)
FREEPIK_API_KEY=your_api_key_here

# WiFi audio source settings
WIFI_HOST=192.168.4.1
WIFI_PORT=5005
WIFI_SAMPLE_RATE=8000

# Whisper model options
MODEL_SIZE=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
TRANSCRIBE_LANGUAGE=es

# Audio chunking/flush behavior
SILENCE_TIMEOUT=1.5     # flush after this long without new audio
MIN_AUDIO_SEC=4.0       # drop clips shorter than this
MAX_BUFFER_SEC=16.0     # force flush when buffer exceeds this length

# Save raw WiFi audio to WAV (0 to disable, 1 to enable)
SAVE_WIFI_WAV=0
SAVE_CLIP_WAV=0
CLIP_WAV_DIR=clips

# Image generation provider: "freepik" or "gemini"
IMAGE_PROVIDER=freepik

# Freepik settings (when IMAGE_PROVIDER=freepik)
ENABLE_FREEPIK=0
FREEPIK_WEBHOOK_URL=https://www.example.com/webhook
FREEPIK_MODEL=gemini-2-5-flash-image-preview
# Freepik model options: gemini-2-5-flash-image-preview, mystic, flux-kontext-pro,
#                        flux-2-pro, flux-2-turbo, flux-2-klein, seedream-v4-5, seedream-v4, z-image

# Gemini/Google settings (when IMAGE_PROVIDER=gemini)
# Get API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-image
# Gemini model options: gemini-2.5-flash-image, gemini-3-pro-image,
#                       gemini-nano-banana, gemini-nano-banana-pro

PRINT_IMAGE=0
PRINT_COMMAND=/usr/bin/lp
PRINT_TO_PDF=0
PRINT_PDF_DIR=printouts
OPEN_IMAGE=0
PRINT_PAGE_SIZE=A4     # Page size for PDF/print: A4 (210x297mm) or A5 (148x210mm) at 300 DPI

DEBUG_TIMING=0
DEBUG=1
